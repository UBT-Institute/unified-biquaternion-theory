    },
    {
      "declaration": "UBT.Action.PsiRestHamiltonian.winding_conjugation",
      "status": "PROVED",
      "conclusion": "gamma5*H_m*gamma5=H_(-m)."
    },
    {
      "declaration": "UBT.Action.PsiRestHamiltonian.equal_chiral_weights",
      "status": "PROVED",
      "conclusion": "For real E!=0,m and arbitrary complex L,R satisfying the actual two component eigenvalue equations, norm(L)^2=norm(R)^2."
    },
    {
      "declaration": "UBT.Action.PsiRestHamiltonian.zero_energy_trivial",
      "status": "PROVED",
      "conclusion": "At real m!=0, the zero-energy component equations imply L=R=0."
    },
    {
      "declaration": "UBT.Action.PsiRestHamiltonian.car",
      "status": "PROVED",
      "conclusion": "The explicit one-mode annihilation matrix obeys b*b^dagger+b^dagger*b=I."
    },
    {
      "declaration": "UBT.Action.PsiRestHamiltonian.negative_mode_reordering",
      "status": "PROVED",
      "conclusion": "For real E, -E*b*b^dagger+E*I=E*b^dagger*b; includes the vacuum subtraction."
    }
